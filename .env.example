# Contact form (Resend). Required for the form to appear on /contact.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional. Where inquiries are delivered. Defaults to the email in src/content/resume.ts.
# With the default sender below, this MUST be the email your Resend account was created with.
CONTACT_TO_EMAIL=muhammadhaim0786@gmail.com

# Optional. Only set after verifying a domain in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# CONTACT_FROM_EMAIL=

# Optional. Your real domain, for Open Graph and canonical links. Vercel's production URL is used if unset.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
